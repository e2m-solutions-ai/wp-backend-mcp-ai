# wp-backend-mcp — environment configuration.
# Copy this file to `.env` and fill in real values for the WP project you're connecting to.
# DO NOT commit `.env` — it contains credentials.
#
# IMPORTANT: wrap any value containing SPACES in double quotes. Node's dotenv
# parser tolerates unquoted spaces, but `source .env` in bash/zsh does NOT —
# unquoted spaces would cause the smoke-test commands in ONBOARDING.md to fail
# with errors like `command not found: <second-token>` or
# `no such file or directory: <part-of-path>`.
# Both `WP_APP_PASSWORD` and `WP_ROOT` (on a Local-by-Flywheel install) routinely
# contain spaces — keep the quotes around their values.

# WordPress site root URL (no trailing slash).
WP_URL=http://yoursite.local

# WordPress admin username (the user the MCP will act as).
WP_USER=admin

# Application Password — generate at:
#   wp-admin → Users → Your Profile → Application Passwords → Add New
# Keep the spaces exactly as WordPress gives them — and keep the double quotes.
WP_APP_PASSWORD="xxxx xxxx xxxx xxxx xxxx xxxx"

# Absolute path to the WordPress install (the folder that contains wp-config.php).
# Used by filesystem tools (create_child_theme, write_theme_file, etc.).
# Wrap in double quotes — Local-by-Flywheel paths contain a space ("Local Sites").
WP_ROOT="/absolute/path/to/wp-project/app/public"

# Shared secret guarding the companion MU-plugin REST routes.
# Generate with:  openssl rand -hex 24
# The EXACT same value must be defined in wp-config.php:
#   define( 'WP_BACKEND_MCP_KEY', '...' );
WP_BACKEND_MCP_KEY=replace-with-openssl-rand-hex-24

# OPTIONAL — set to 1 to allow the run_php tool (arbitrary PHP execution).
# Off by default. Requires also defining WP_BACKEND_MCP_ALLOW_EVAL=true in wp-config.php.
# Only enable for trusted local dev environments.
# WP_BACKEND_MCP_ALLOW_EVAL=0

# OPTIONAL — accept self-signed TLS certs when WP_URL uses https://.
# Local-by-Flywheel, MAMP, etc. serve dev sites with self-signed certs
# that Node rejects by default. Off by default; opt-in for dev only.
# WP_INSECURE_TLS=1
